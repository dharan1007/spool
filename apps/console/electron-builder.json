{
  "appId": "io.spool.console",
  "productName": "SPOOL Console",
  "directories": {
    "output": "dist/package"
  },
  "files": [
    "electron/**/*",
    "preload/**/*",
    "dist/renderer/**/*",
    "service/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "engine",
      "to": "engine",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/bindings/**",
    "node_modules/file-uri-to-path/**",
    "node_modules/zod/**"
  ],
  "win": {
    "target": [{ "target": "dir", "arch": ["x64"] }],
    "signAndEditExecutable": false
  }
}
