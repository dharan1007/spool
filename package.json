{
  "name": "spool-webmcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first migration correctness infrastructure with a verified CSV-to-SQLite runner",
  "bin": {
    "spool": "src/cli/spool.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js tests/conformance/*.test.js",
    "test:core": "node --test tests/core.test.js tests/transforms.test.js tests/migration.test.js",
    "test:webmcp": "node --test tests/webmcp.test.js",
    "test:security": "node --test tests/security.test.js tests/platform-security.test.js tests/credential-broker.test.js tests/path-policy.test.js",
    "test:conformance": "node --test tests/sqlite-target.test.js tests/sqlite-preflight.test.js tests/crash-recovery.test.js tests/fencing.test.js tests/conformance/*.test.js",
    "benchmark": "node benchmarks/run.js",
    "check": "npm test && npm run build && npm run benchmark && node scripts/static-check.js",
    "pack:verify": "node scripts/verify-package.js",
    "serve": "python3 scripts/spa-server.py --port 8765 --directory dist",
    "build": "node scripts/build-dist.js"
  },
  "dependencies": {
    "better-sqlite3": "12.10.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
